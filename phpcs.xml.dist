<?xml version="1.0"?>
<ruleset name="ContactIn">
    <description>WordPress Coding Standards for ContactIn free plugin.</description>

    <!-- Scan PHP files only -->
    <arg name="extensions" value="php"/>

    <!-- Paths to check -->
    <file>.</file>

    <!-- Excluded paths -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>dist/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <!-- Base standard -->
    <rule ref="WordPress">
        <!--
            === Documentation / Style-only rules suppressed ===
            These are cosmetic and do not affect security or functionality.
            The large legacy codebase has these throughout; suppressing them
            keeps the scan focused on actionable security/quality issues.
        -->

        <!-- Comment format rules -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.WrongStyle"/>
        <exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <exclude name="Squiz.PHP.CommentedOutCode.Found"/>

        <!-- Yoda conditions: style preference, not security-relevant -->
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

        <!-- File naming: renaming would break PSR-4 autoloader -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

        <!-- Variable naming: camelCase used consistently in this codebase -->
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>

        <!-- Short ternary ?: — will be fixed in a follow-up sweep -->
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>

        <!--
            Template files receive variables from the controller layer via TemplateLoader.
            The variables ($paged, $pages, $search, $status, etc.) are local template
            state initialized with defaults, not harmful overrides of WordPress globals.
            Scoped exclusion only for the templates/ directory.
        -->
        <rule ref="WordPress.WP.GlobalVariablesOverride">
            <exclude-pattern>templates/*</exclude-pattern>
        </rule>

        <!--
            ContactIn intentionally uses a near-real-time custom cron interval for
            queue/post-submit homework processing. Keep the rule active elsewhere.
        -->
        <rule ref="WordPress.WP.CronInterval">
            <exclude-pattern>includes/Core/CoreBootstrap.php</exclude-pattern>
        </rule>

    <!-- Minimum PHP version compatibility baseline -->
    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="7.4-"/>
</ruleset>
